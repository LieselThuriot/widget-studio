{
  "name": "widget-studio",
  "version": "0.2.0",
  "description": "Browser editor for composing, previewing, and sharing data-driven dashboard widgets.",
  "author": {
    "name": "Liesel Thuriot"
  },
  "license": "MIT",
  "homepage": "https://widget-studio.liesel.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/LieselThuriot/widget-studio.git"
  },
  "bugs": {
    "url": "https://github.com/LieselThuriot/widget-studio/issues"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:libraries && npm run build:app",
    "build:app": "ng build widget",
    "build:renderer": "ng build widget-renderer",
    "build:landscape": "ng build widget-landscape",
    "build:libraries": "ng build widget-renderer && ng build widget-landscape",
    "pack:renderer": "npm pack ./dist/widget-renderer --pack-destination ./dist",
    "pack:landscape": "npm pack ./dist/widget-landscape --pack-destination ./dist",
    "pack:libraries": "npm run build:libraries && npm run pack:renderer && npm run pack:landscape",
    "verify:renderer-package": "node scripts/verify-renderer-package.mjs",
    "verify:landscape-package": "node scripts/verify-landscape-package.mjs",
    "verify:packages": "npm run verify:renderer-package && npm run verify:landscape-package",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"projects/**/*.{ts,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\" \"projects/**/*.{ts,css,html}\"",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@12.2.2",
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "d3-array": "^3.2.5",
    "d3-shape": "^3.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@eslint/js": "^10.0.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-shape": "^3.2.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "ng-packagr": "^22.2.6",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.7": true
  }
}
