{
  "name": "widget",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:libraries && npm run build:app",
    "build:app": "ng build widget",
    "build:renderer": "ng build widget-renderer",
    "build:landscape": "ng build widget-landscape",
    "build:libraries": "ng build widget-renderer && ng build widget-landscape",
    "pack:renderer": "npm pack ./dist/widget-renderer --pack-destination ./dist",
    "pack:landscape": "npm pack ./dist/widget-landscape --pack-destination ./dist",
    "pack:libraries": "npm run build:libraries && npm run pack:renderer && npm run pack:landscape",
    "verify:renderer-package": "node scripts/verify-library-package.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"projects/**/*.{ts,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\" \"projects/**/*.{ts,css,html}\"",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "echarts": "^6.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
